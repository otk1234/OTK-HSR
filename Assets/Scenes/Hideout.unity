MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1923348730}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abfe4d9e260ddeb4ba8c34227b2ee76c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HideoutSpot
  displayName: "\uBB3C\uAC74"
  requiredTrait: 0
  requiredCharacter: 0
  failMessage: "\uB098\uB294 \uD560 \uC218 \uC5C6\uB2E4..."
  noiseRadius: 0
  owner: 1
  label: "\uCE60\uD310 \uC55E\uC5D0\uC11C \uC0AC\uAC74\uC744 \uBCF8\uB2E4"
  talks:
  - lines:
    - speaker: 1
      text: "...\uC544\uBE60\uAC00 \uC65C \uC774 \uC0AC\uB78C\uB4E4\uC744 \uACE8\uB790\uB294\uC9C0, \uC544\uC9C1 \uBAA8\uB974\uACA0\uC5B4."
    - speaker: 2
      text: "\uB108\uBB34 \uBD99\uC7A1\uACE0 \uC788\uC9C0 \uB9C8. \uB208 \uBE60\uC9C0\uACA0\uB2E4."
  - lines:
    - speaker: 1
      text: "\uCE60\uD310\uC5D0 \uBD99\uC77C \uAC8C \uB298\uC5B4\uB0A0\uC218\uB85D, \uC544\uBE60\uAC00 \uB0AF\uC124\uC5B4\uC838."
    - speaker: 2
      text: "...\uADF8\uB798\uB3C4 \uC6B0\uB9AC \uC544\uBE60\uC57C."
  talksAfterCase:
  - lines:
    - speaker: 1
      text: "302\uD638. \uCC3B\uC794\uC774 \uB450 \uAC1C\uC600\uC5B4. \uC544\uBE60\uB294 \uADF8 \uC0AC\uB78C\uC774\uB791 \uCC28\uB97C \uB9C8\uC168\uB358 \uAC70\uC57C."
    - speaker: 2
      text: "\uC544\uB294 \uC0AC\uC774\uC600\uB2E4\uB294 \uAC70\uC9C0."
    - speaker: 1
      text: "\uC751. \uADF8\uB798\uC11C \uB354 \uBB34\uC11C\uC6CC."
--- !u!1 &1932843887
