--- !u!114 &513429966
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 513429963}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: abfe4d9e260ddeb4ba8c34227b2ee76c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HideoutSpot
  displayName: "\uBB3C\uAC74"
  requiredTrait: 0
  requiredCharacter: 0
  failMessage: "\uB098\uB294 \uD560 \uC218 \uC5C6\uB2E4..."
  noiseRadius: 0
  owner: 1
  label: "\uC9C0\uB3C4 \uD14C\uC774\uBE14 \uC606\uC5D0\uC11C \uACE0\uBBFC\uD55C\uB2E4"
  talks:
  - lines:
    - speaker: 1
      text: "\uB2E4\uC74C\uC5D4 \uC5B4\uB514\uB85C \uAC08\uC9C0... \uC624\uBE60 \uC0DD\uAC01\uC740 \uC5B4\uB54C?"
    - speaker: 2
      text: "\uB124\uAC00 \uC815\uD574. \uB09C \uBB38 \uB530\uB294 \uAC70\uB098 \uD560\uAC8C."
  - lines:
    - speaker: 1
      text: "\uC9C0\uB3C4\uB85C \uBCF4\uB2C8\uAE4C \uC774 \uB3C4\uC2DC, \uC0DD\uAC01\uBCF4\uB2E4 \uC881\uB124."
    - speaker: 2
      text: "\uADF8\uB7EC\uB2C8\uAE4C \uC544\uBE60\uB3C4 \uBA40\uB9AC \uBABB \uAC14\uC744 \uAC70\uC57C."
  talksAfterCase:
  - lines:
    - speaker: 1
      text: "\uC218\uCCA9\uC5D0 \uC801\uD78C \uB300\uB85C\uB77C\uBA74, \uB2E4\uC74C\uC740 \uBC15 \uC120\uC0DD \uB301\uC774\uC57C."
    - speaker: 2
      text: "\uBAA9\uC694\uC77C \uBC24 9\uC2DC. \uC2DC\uAC04\uC774 \uC5C6\uB124."
