  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HideoutSpot
  displayName: "\uBB3C\uAC74"
  requiredTrait: 0
  requiredCharacter: 0
  failMessage: "\uB098\uB294 \uD560 \uC218 \uC5C6\uB2E4..."
  noiseRadius: 0
  owner: 2
  label: "\uC0C1\uC790 \uC606 \uBCBD\uC5D0 \uAE30\uB300 \uC270\uB2E4"
  talks:
  - lines:
    - speaker: 2
      text: "\uC7A0\uAE50\uB9CC \uC774\uB7EC\uACE0 \uC788\uC744\uAC8C. \uB2E4\uB9AC\uAC00 \uC880 \uC464\uC154."
  - lines:
    - speaker: 2
      text: "\uC5EC\uAE30 \uB2E4\uB77D\uBC29, \uC5B4\uB9B4 \uB54C \uC228\uBC14\uAF2D\uC9C8\uD558\uB358 \uB370\uC796\uC544."
    - speaker: 1
      text: "...\uADF8\uB550 \uC544\uBE60\uAC00 \uC220\uB798\uC600\uC9C0."
  talksAfterCase:
  - lines:
    - speaker: 2
      text: "\uADF8 \uC9D1 \uCC45\uC7A5, \uC0DD\uAC01\uBCF4\uB2E4 \uBB34\uAC70\uC6E0\uC5B4."
    - speaker: 1
      text: "\uB355\uBD84\uC5D0 \uC218\uCCA9\uC744 \uCC3E\uC558\uC796\uC544."
