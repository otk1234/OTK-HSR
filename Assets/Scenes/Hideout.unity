  m_Script: {fileID: 11500000, guid: abfe4d9e260ddeb4ba8c34227b2ee76c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HideoutSpot
  displayName: "\uBB3C\uAC74"
  requiredTrait: 0
  requiredCharacter: 0
  failMessage: "\uB098\uB294 \uD560 \uC218 \uC5C6\uB2E4..."
  noiseRadius: 0
  owner: 2
  label: "\uC791\uC5C5\uB300 \uC758\uC790\uC5D0 \uC549\uC544 \uAE30\uACC4\uB97C \uB9CC\uC9C4\uB2E4"
  talks:
  - lines:
    - speaker: 2
      text: "\uC774 \uB179\uC74C\uAE30, \uC870\uAE08\uB9CC \uC190\uBCF4\uBA74 \uC4F8 \uB9CC\uD558\uACA0\uB294\uB370."
    - speaker: 1
      text: "\uADF8\uAC78\uB85C \uBB50 \uD558\uAC8C?"
    - speaker: 2
      text: "\uC5B8\uC820\uAC04 \uC4F8 \uB370\uAC00 \uC788\uACA0\uC9C0."
  - lines:
    - speaker: 2
      text: "\uACF5\uAD6C\uAC00 \uD558\uB098 \uBE60\uC84C\uC5B4. \uB108 \uD639\uC2DC \uB9CC\uC84C\uB0D0?"
    - speaker: 1
      text: "\uC544\uB2C8. \uC624\uBE60\uAC00 \uC5B4\uC81C \uC0C1\uC790\uC5D0 \uB123\uC5C8\uC796\uC544."
  talksAfterCase:
  - lines:
    - speaker: 2
      text: "302\uD638 \uC778\uD130\uD3F0, \uC804\uC120\uB9CC \uB04A\uACA8 \uC788\uC5C8\uC5B4. \uC544\uBE60\uAC00 \uB04A\uC740 \uAC70\uACA0\uC9C0."
    - speaker: 1
      text: "\uC544\uBE60\uB294 \uAE30\uACC4\uB97C \uC798 \uBAB0\uB790\uB294\uB370..."
    - speaker: 2
      text: "...\uADF8\uB7EC\uAC8C."
