  caseId: case302
  caseTitle: "302\uD638 \uC0B4\uC778 \uC0AC\uAC74 (\uC784\uC2DC)"
  questions:
  - id: relation
    text: "\uD53C\uD574\uC790\uC640 \uBC94\uC778\uC740 \uC5B4\uB5A4 \uC0AC\uC774\uC600\uC744\uAE4C?"
    options:
    - text: "\uBAA8\uB974\uB294 \uC0AC\uB78C. \uAC15\uB3C4\uAC00 \uB4E4\uC5C8\uB2E4."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    - text: "\uC544\uB294 \uC0AC\uC774. \uCC28\uB97C \uB300\uC811\uD588\uACE0, \uB4F1\uC744 \uBCF4\uC77C \uB9CC\uD07C \uBBFF\uC5C8\uB2E4."
      correct: 1
      needAnyClue:
      - two_cups
      - head_wound
      onlyFor: 0
    - text: "\uC0AC\uACE0\uC600\uB2E4. \uB118\uC5B4\uC9C0\uBA70 \uC7AC\uB5A8\uC774\uC5D0 \uBD80\uB52A\uCCE4\uB2E4."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    wrongConsequence: "\uBC94\uC778\uC744 \uB0AF\uC120 \uC0AC\uB78C\uC73C\uB85C \uBCF4\uACE0 \uC5C9\uB6B1\uD55C \uBC29\uD5A5\uC744 \uCAD3\uB294\uB2E4."
  - id: culprit
    text: "\uBC94\uC778\uC740 \uB204\uAD6C\uC778\uAC00?"
    options:
    - text: "\uC544\uD30C\uD2B8 \uACBD\uBE44\uC6D0."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    - text: "\uC544\uBE60\uB2E4. \uC190\uD1B1 \uBC11 \uC12C\uC720\uAC00 \uC544\uBE60\uC758 \uB0A8\uC0C9 \uC678\uD22C\uC640 \uAC19\uB2E4."
      correct: 1
      needAnyClue:
      - navy_fiber
      onlyFor: 1
    - text: "\uC544\uBE60\uB2E4. \uB179\uD654 \uC601\uC0C1 \uC18D \uAC78\uC74C\uAC78\uC774\uAC00 \uC544\uBE60\uB2E4."
      correct: 1
      needAnyClue:
      - intercom_video
      onlyFor: 0
    - text: "\uD53C\uD574\uC790\uC758 \uB2E4\uB978 \uC9C0\uC778."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    wrongConsequence: "\uC5C9\uB6B1\uD55C \uC0AC\uB78C\uC744 \uC758\uC2EC\uD558\uB294 \uC0AC\uC774, \uC544\uBC84\uC9C0\uB294 \uC790\uC720\uB86D\uAC8C \uC6C0\uC9C1\uC778\uB2E4."
  - id: next_target
    text: "\uC544\uBC84\uC9C0\uC758 \uB2E4\uC74C \uBC94\uD589\uC740?"
    options:
    - text: "\uBAA9\uC694\uC77C \uBC24 9\uC2DC, \uBC15 \uC120\uC0DD \uB301."
      correct: 1
      needAnyClue:
      - victim_diary
      onlyFor: 0
    - text: "\uC606\uC9D1 \uC0AC\uB78C. \uBC94\uD589\uC744 \uBD24\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    - text: "\uB354\uB294 \uC5C6\uB2E4. \uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9\uC774\uB2E4."
      correct: 0
      needAnyClue: []
      onlyFor: 0
    wrongConsequence: "\uB2E4\uC74C \uD53C\uD574\uC790\uB97C \uC798\uBABB \uC9DA\uC5B4, \uB2E4\uC74C \uC0AC\uAC74\uC5D0\uC11C \uC190\uC4F8 \uC218 \uC5C6\uB294 \uC0C1\uD0DC\uB85C \uC2DC\uC791\uD55C\uB2E4."
